{
  "name": "monster-siren",
  "private": true,
  "version": "1.0.0",
  "description": "塞壬唱片 (Monster Siren Records) 桌面播放器",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit -p tsconfig.json && vite build --configLoader native",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --configLoader native",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
